# MaintainPro backend — Render production template
# Set these in Render Environment Variables / Secret Files; do not commit real values.

NODE_ENV=production
PORT=10000

# Public URLs. Replace the API URL with the actual Render backend URL.
CLIENT_URL=https://maintainpro.samueldev.cv
FRONTEND_URL=https://maintainpro.samueldev.cv

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Set this to the complete Redis provider URL in Render. Do not copy the placeholder.
# Example shape: rediss://default:URL_ENCODED_PASSWORD@redis-host.example.com:6379
REDIS_URL=
QUEUE_DRIVER=bullmq
WORKER_QUEUES=domain-events,email,notification

JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
OAUTH_STATE_SECRET=replace-with-a-third-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_EXPIRES_IN=10m

# Resend is the only supported email provider.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM_NAME=MaintainPro
MAIL_FROM_EMAIL=noreply@maintainpro.samueldev.cv

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT_URI=https://<render-backend-host>.onrender.com/api/v1/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CLIENT_REDIRECT_URI=

# Production cannot use the mock billing provider.
BILLING_DEFAULT_PROVIDER=stripe
# Optional public display rates only. SaaS billing remains based on USD plan prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Tunnels are disabled in production.
TUNNEL_PROVIDER=none
TUNNEL_AUTOSTART=false
TUNNEL_PORT=
