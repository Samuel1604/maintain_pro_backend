# Copy to .env.production only for local production-like validation.
# In deployed environments, set these through the platform secret manager.
NODE_ENV=production
PORT=8000
CLIENT_URL=https://app.example.com
FRONTEND_URL=https://app.example.com

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/maintainpro?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<host>:<port>
QUEUE_DRIVER=bullmq
BILLING_DEFAULT_PROVIDER=stripe

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
OAUTH_STATE_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_EXPIRES_IN=10m

MAIL_PROVIDER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=production-smtp-user
MAIL_PASSWORD=production-smtp-password
MAIL_FROM_NAME=MaintainPro
MAIL_FROM_EMAIL=noreply@example.com

GOOGLE_CLIENT_ID=production-google-client-id
GOOGLE_CLIENT_SECRET=production-google-client-secret
GOOGLE_CLIENT_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

# Configure only the payment providers that are enabled for your deployment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Tunnels are local-development tooling and must remain disabled in production.
TUNNEL_PROVIDER=none
TUNNEL_AUTOSTART=false
