# Test-only environment configuration.
#
# Loaded explicitly by src/tests/vitest.setup.ts (via dotenv, before any
# other module — including env.ts — is imported). This keeps the test
# suite fully self-contained and independent of whatever real .env the
# developer has locally: it never overwrites already-set process.env
# values, so this file only matters when nothing else has set a variable.
#
# Database-backed tests use a disposable local MongoDB service by default.
# CI may override this value with its service URI. Keeping the URI explicit
# avoids relying on a platform-specific mongodb-memory-server binary.
#
# Redis/BullMQ DOES need a real, reachable instance: the domain event bus
# (QueuedEventBus) enqueues real BullMQ jobs on every publish() call
# (login, lockout, session events, etc.), so tests need Redis actually
# running at REDIS_HOST:REDIS_PORT. Point this at a disposable local/CI
# Redis — never a shared or production instance.

NODE_ENV=test
PORT=8080
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/maintainpro_test
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/maintainpro_test

JWT_ACCESS_SECRET=test-access-secret-please-change-32chars
JWT_REFRESH_SECRET=test-refresh-secret-please-change-32ch
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OAUTH_STATE_SECRET=test-oauth-state-secret-please-32chars
OAUTH_STATE_EXPIRES_IN=10m

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

MAIL_PROVIDER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=MaintainPro Test
MAIL_FROM_EMAIL=noreply@maintainpro.test
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CLIENT_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
