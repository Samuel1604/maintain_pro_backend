# MaintainPro backend — local development template
# Never commit real secrets. Render production values belong in Render's Environment tab.

NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/maintainpro

JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
OAUTH_STATE_SECRET=replace-with-a-third-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_EXPIRES_IN=10m

# Queue: use in-memory locally; Render production must use bullmq with Redis.
QUEUE_DRIVER=in-memory
WORKER_QUEUES=domain-events,email,notification
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Resend is the only supported email provider.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM_NAME=MaintainPro
MAIL_FROM_EMAIL=noreply@maintainpro.samueldev.cv

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CLIENT_REDIRECT_URI=

BILLING_DEFAULT_PROVIDER=mock
# Optional JSON map of USD=1 to public display-currency rates, e.g. {"NGN":1600,"GBP":0.79,"EUR":0.92}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

TUNNEL_PROVIDER=none
TUNNEL_AUTOSTART=false
TUNNEL_PORT=
