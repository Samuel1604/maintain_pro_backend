# Server
NODE_ENV=development
PORT=8000

# Database
MONGODB_URI=mongodb://localhost:27017/maintainpro

# Client
CLIENT_URL=http://localhost:3000

# JWT — each must be a random string of at least 32 characters
JWT_ACCESS_SECRET=replace-with-a-random-32-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth state signing — random string of at least 32 characters
OAUTH_STATE_SECRET=replace-with-a-random-32-char-secret
OAUTH_STATE_EXPIRES_IN=10m

# Redis
# Preferred for managed Redis providers (copy the complete rediss:// URL,
# including username/password when supplied). Leave blank when using host fields.

REDIS_URL=rediss://default:<password>@<host>:<port>
# Use in-memory jobs during local development to avoid BullMQ polling quotas
# on serverless Redis plans (for example Upstash request limits).
QUEUE_DRIVER=in-memory
BILLING_DEFAULT_PROVIDER=mock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
# Keep true unless your provider uses a private/self-signed certificate.
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Email
# MAIL_PROVIDER selects the active EmailProvider implementation: "smtp" | "brevo" | "mailforge"
# "smtp" is a generic Nodemailer/SMTP transport — it works with Mailpit locally
# and with any real SMTP endpoint (Gmail, Resend, Brevo, SES, Postmark, ...) in
# other environments. Switching between all of these is a config-only change:
# update MAIL_HOST/MAIL_PORT/MAIL_SECURE/MAIL_USER/MAIL_PASSWORD below — no
# application code changes, ever. "brevo"/"resend" use their respective HTTP
# APIs instead of SMTP.
MAIL_PROVIDER=smtp

# --- Mailforge (HTTP API) — required when MAIL_PROVIDER=mailforge ---
MAILFORGE_URL=http://localhost:8080
MAILFORGE_ACCOUNT_ID=
MAILFORGE_API_KEY=

# --- Local development: Mailpit ---
# Mailpit's default SMTP listener needs no credentials — leave MAIL_USER and
# MAIL_PASSWORD unset (both must be set together, or both left blank).
# View captured mail in Mailpit's web UI (default http://localhost:8025).
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# --- Example: real SMTP providers (production) ---
# Gmail:            MAIL_HOST=smtp.gmail.com     MAIL_PORT=587 MAIL_SECURE=false
#                    MAIL_USER=you@gmail.com      MAIL_PASSWORD=<Google App Password>
# Resend SMTP:       MAIL_HOST=smtp.resend.com    MAIL_PORT=587 MAIL_USER=resend
#                    MAIL_PASSWORD=<Resend API key>
# Brevo SMTP:        MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 MAIL_USER=<Brevo SMTP login>
#                    MAIL_PASSWORD=<Brevo SMTP key>
# Amazon SES SMTP:   MAIL_HOST=email-smtp.<region>.amazonaws.com MAIL_PORT=587
#                    MAIL_USER=<SES SMTP username> MAIL_PASSWORD=<SES SMTP password>
# Postmark SMTP:     MAIL_HOST=smtp.postmarkapp.com MAIL_PORT=587
#                    MAIL_USER=<Postmark server token> MAIL_PASSWORD=<same token>

# Brevo (HTTP API) — required when MAIL_PROVIDER=brevo instead of smtp
BREVO_API_KEY=your-brevo-api-key

# Resend (HTTP API) — required when MAIL_PROVIDER=resend instead of smtp
RESEND_API_KEY=your-resend-api-key

MAIL_FROM_NAME="MaintainPro"
MAIL_FROM_EMAIL="noreply@maintainpro.com"
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CLIENT_REDIRECT_URI=

# Payment providers (server-side only; never expose these in frontend env)
# Development defaults to mock. When exercising a real integration locally,
# use each provider's TEST credentials and TEST webhook secret; never point a
# test credential at a production webhook endpoint. Switch to live credentials
# only during a controlled production deployment.
# Stripe: use sk_test_* + a whsec_* secret from a test-mode endpoint.
# Paystack: use sk_test_* and the test dashboard webhook configuration.
# Flutterwave: use test secret keys and the test-mode webhook hash.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Optional local-development ingress tunnel. Never enable this in production.
TUNNEL_PROVIDER=none
TUNNEL_AUTOSTART=false
TUNNEL_PORT=
